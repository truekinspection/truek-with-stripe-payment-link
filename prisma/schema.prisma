generator client {
  provider   = "prisma-client"
  // App imports from @/prisma/generated/client
  output     = "../src/prisma/generated/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  vinNumber String
  createdAt DateTime @default(now())
}

model Payment {
  id        Int           @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  plan      String?
  orderID   String?       @unique
  status    ReportStatus?
  createdAt DateTime      @default(now())
}

enum ReportStatus {
  STARTED
  PENDING
  COMPLETED
}

model Contact {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  vnnumber  String
  message   String?
  createdAt DateTime @default(now())
}

/// Time-limited token for full report preview (default 30 days after issuance).
model ReportPreviewToken {
  id                String   @id @default(cuid())
  token             String   @unique
  html              String   @db.Text
  vin               String
  /// ClearVin report id when returned by the vendor API (enables free re-fetch by reportId).
  clearvinReportId  String?
  /// Stripe Checkout Session id from Payment Link — used for idempotent fulfillment.
  stripeSessionId   String?  @unique
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}

