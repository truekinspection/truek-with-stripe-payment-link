# 1. DATABASE
DATABASE_URL=

# 2. APP URLS
NEXT_PUBLIC_URL="https://www.usa.truekinspection.com/"
NEXT_PUBLIC_APP_URL="https://www.usa.truekinspection.com/"

# 3. EMAIL (RESEND)
RESEND_API_KEY=
# Ops inbox(es) for payment/report notifications (comma-separated for owner + admin)
# defaults to truekinspection@gmail.com
OWNER_EMAIL=truekinspection@gmail.com
RESEND_EMAIL=

# 4. Stripe API credentials
STRIPE_SECRET_KEY=
# Payment Link URL (used by the Get Full Report button on /check-vin)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# 4b. Payment Provider Switch
# "stripe" = use Stripe Payment Link (default, production-safe)
# "whop"   = use Whop checkout
PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# 4c. Whop API credentials (only required when PAYMENT_PROVIDER=whop)
WHOP_API_KEY=
WHOP_API_BASE_URL=https://api.whop.com/api/v1
WHOP_PLAN_ID=
# Webhook signing secret from Whop Dashboard → Webhooks (starts with ws_)
WHOP_WEBHOOK_SECRET=

# 5. CLEARVIN API (v2.0 vendor REST)
# Environment switch:
#   CLEARVIN_ENV=test|production  (optional; defaults from NODE_ENV)
# Test / staging: static Bearer token — no login. Only approved test VINs work.
# Production: email/password login → JWT (120m), auto-refresh before expiry.
CLEARVIN_ENV=
NEXT_PUBLIC_CLEARVIN_ENV=
CLEARVIN_TEST_TOKEN=
CLEARVIN_EMAIL=
CLEARVIN_PASSWORD=
